{
  "name": "dejamove",
  "version": "0.1.0",
  "private": true,
  "description": "DejaMove - Chess opening move repetition trainer",
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "build:core": "cmake --build core/build --config Release --target dejamove-core",
    "build": "npm run build:core && npm --prefix ui run build",
    "launch": "node scripts/launch.mjs",
    "package": "npm run build:core && npm --prefix ui run package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
